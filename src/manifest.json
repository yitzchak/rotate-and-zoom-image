{
  "applications": {
    "gecko": {
      "id": "tranform-image@yitzchak.github.io",
      "strict_min_version": "68.0"
    }
  },
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "3.0",
  "author": "Tarn W. Burton",
  "browser_specific_settings": {
    "gecko": {
      "id": "tranform-image@yitzchak.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "img/rotate-photo.svg"
  },
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "options_ui": {
    "page": "html/options-ui.html",
    "browser_style": true
  },
  "background": {
    "scripts": [
        "js/MessageSender.js",
        "js/Options.js",
        "js/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/Options.js",
        "js/ImageContainer.js",
        "js/MessageListener.js",
        "js/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
